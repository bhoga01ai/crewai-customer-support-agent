# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# --- LLM provider ---
# This project is set up for Groq. MODEL is a LiteLLM model string, so
# switching providers is a matter of changing it and supplying that
# provider's key instead.
GROQ_API_KEY=gsk_your-groq-api-key-here
MODEL=groq/openai/gpt-oss-120b

# Other providers, for reference:
# OPENAI_API_KEY=sk-...        with MODEL=openai/gpt-4o
# ANTHROPIC_API_KEY=sk-ant-... with MODEL=anthropic/claude-sonnet-4-5

# --- Contract vs. invoice audit (`uv run audit`) ---
# Optional: audit a different document pair. Either a filename inside
# data/documents/ or an absolute path to a PDF anywhere on disk.
# Defaults to the two sample documents in data/documents/.
# CONTRACT_PDF=purchase_terms_conditions.pdf
# INVOICE_PDF=sample_invoice.pdf

# --- Support insights flow (`uv run kickoff`) ---
# Optional: set the focus area for the report non-interactively, e.g.
# FOCUS_AREA=billing
# One of: billing, technical, account, shipping, product_feedback,
# or any free-text keyword (e.g. "refund", "login"). Defaults to "all tickets".
FOCUS_AREA=
