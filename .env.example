# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Required: OpenAI API key used by the crew's agents (default LLM provider).
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: override the default model (see agents.yaml `llm:` overrides too).
# MODEL=gpt-4o

# Optional: set the focus area for the report non-interactively, e.g.
# FOCUS_AREA=billing
# One of: billing, technical, account, shipping, product_feedback,
# or any free-text keyword (e.g. "refund", "login"). Defaults to "all tickets".
FOCUS_AREA=
